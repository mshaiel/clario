# -----------------------------------------------------------------------------
# Clario Backend Microservices - Environment Variables
# Copy to .env in the root directory before running docker-compose up
# -----------------------------------------------------------------------------

# Google Gemini API Key (Required for adaptive content generation in training-service)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Service Account (Optional for local testing without Firestore)
# Can be provided either as raw JSON string or as a path to a key.json file:
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Inter-Service Routing (Preconfigured for Docker Compose network)
ANALYSIS_BACKEND_URL=http://analysis-service:7860
TRAINING_BACKEND_URL=http://training-service:7860
CTMK_URL=http://techniques-service:7860
CAM_URL=http://analysis-service:7860

# Model Configuration
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
AUDIO_SAMPLE_RATE=16000
