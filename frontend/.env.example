# -----------------------------------------------------------------------------
# Clario Frontend - Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# -----------------------------------------------------------------------------

# Firebase Client Configuration (from Firebase Console -> Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890

# Backend Service URLs
# Default values point to the hosted HuggingFace Spaces.
# For local Docker Compose development, point to http://localhost:<port>.
EXPO_PUBLIC_API_URL=https://junaiddbz-clario-unified-assistant.hf.space/v1
EXPO_PUBLIC_CTM_BASE_URL=https://junaiddbz-clario-training-module.hf.space
EXPO_PUBLIC_CAM_BASE_URL=https://junaiddbz-clario-analysis-module.hf.space

# Delayed Auditory Feedback (DAF) Web Audio Page URL
EXPO_PUBLIC_DAF_URL=https://mshaiel.github.io/clario-daf/daf.html

# Runtime Flags
EXPO_PUBLIC_CTM_FORCE_MOCK=false
EXPO_PUBLIC_CTM_TIMEOUT_MS=12000
EXPO_PUBLIC_CTM_RETRY_ATTEMPTS=2
